# Nexus AI Agent SaaS - Environment Variables Template
# Ushbu fayldan nusxa olib, nomini .env qiling va kalitlaringizni kiriting
PORT=8000

# AI Provider API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
NAVY_API_KEY=your_navy_api_key_here
